+/// Fast one-shot substring search that avoids `memmem::FinderBuilder` construction
+/// overhead on short URLs and hostnames.
+#[inline]
+fn fast_find_bytes(haystack: &[u8], needle: &[u8]) -> Option<usize> {
+    let nlen = needle.len();
+    if nlen == 0 {
+        return Some(0);
+    }
+    let hlen = haystack.len();
+    if nlen > hlen {
+        return None;
+    }
+    if nlen == 1 {
+        return memchr::memchr(needle[0], haystack);
+    }
+    if hlen > 512 && nlen > 16 {
+        return memmem::find(haystack, needle);
+    }
+    // Prefer scanning for a less frequent byte than leading '/', '.', or '-' common in URL filters.
+    let first = needle[0];
+    let last_offset = nlen - 1;
+    let last = needle[last_offset];
+    let anchor_off = if matches!(first, b'/' | b'.' | b'-' | b'_' | b'a' | b'e' | b's' | b't')
+        && !matches!(last, b'/' | b'.' | b'-' | b'_' | b'a' | b'e' | b's' | b't')
+    {
+        last_offset
+    } else if nlen >= 3
+        && matches!(first, b'/' | b'.' | b'-' | b'_' | b'a' | b'e' | b's' | b't')
+    {
+        nlen / 2
+    } else {
+        0
+    };
+    let anchor_byte = needle[anchor_off];
+    let tail_after = last_offset - anchor_off;
+    let search_end = hlen - tail_after;
+    let mut pos = anchor_off;
+    while pos < search_end {
+        let Some(rel) = memchr::memchr(anchor_byte, &haystack[pos..search_end]) else {
+            return None;
+        };
+        let hit = pos + rel;
+        let idx = hit - anchor_off;
+        if haystack[idx] == first
+            && haystack[idx + last_offset] == last
+            && haystack[idx..idx + nlen] == *needle
+        {
+            return Some(idx);
+        }
+        pos = hit + 1;
+    }
+    None
+}
 
