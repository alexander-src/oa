@@ -0,0 +1,153 @@
+import {
+  EVENT_ID,
+  CHOMPING_MODE,
+  type Event,
+  type ScalarStyle,
+  type CollectionStyle,
+  type ChompingMode,
+  type DocumentEvent
+} from './events.ts'
+
+const NO_RANGE = -1
+
+const TAPE_DOCUMENT = 1
+const TAPE_SEQ_FAST = 2
+const TAPE_SEQ_FULL = 3
+const TAPE_MAP_FAST = 4
+const TAPE_MAP_FULL = 5
+const TAPE_SCALAR_FAST = 6
+const TAPE_SCALAR_FULL = 7
+const TAPE_ALIAS = 8
+const TAPE_POP = 9
+
+interface EventTape {
+  data: Int32Array
+  length: number
+  docs: DocumentEvent[]
+}
+
+function materializeEvents (tape: EventTape): Event[] {
+  const { data, length, docs } = tape
+  const events: Event[] = []
+  let i = 0
+
+  while (i < length) {
+    const header = data[i++]
+    const kind = header & 0x0F
+
+    switch (kind) {
+      case TAPE_DOCUMENT: {
+        events.push(docs[data[i++]])
+        break
+      }
+      case TAPE_SEQ_FAST: {
+        events.push({
+          type: EVENT_ID.SEQUENCE,
+          start: data[i++],
+          anchorStart: NO_RANGE,
+          anchorEnd: NO_RANGE,
+          tagStart: NO_RANGE,
+          tagEnd: NO_RANGE,
+          style: ((header >>> 4) & 0x0F) as CollectionStyle
+        })
+        break
+      }
+      case TAPE_SEQ_FULL: {
+        events.push({
+          type: EVENT_ID.SEQUENCE,
+          start: data[i++],
+          anchorStart: data[i++],
+          anchorEnd: data[i++],
+          tagStart: data[i++],
+          tagEnd: data[i++],
+          style: data[i++] as CollectionStyle
+        })
+        break
+      }
+      case TAPE_MAP_FAST: {
+        events.push({
+          type: EVENT_ID.MAPPING,
+          start: data[i++],
+          anchorStart: NO_RANGE,
+          anchorEnd: NO_RANGE,
+          tagStart: NO_RANGE,
+          tagEnd: NO_RANGE,
+          style: ((header >>> 4) & 0x0F) as CollectionStyle
+        })
+        break
+      }
+      case TAPE_MAP_FULL: {
+        events.push({
+          type: EVENT_ID.MAPPING,
+          start: data[i++],
+          anchorStart: data[i++],
+          anchorEnd: data[i++],
+          tagStart: data[i++],
+          tagEnd: data[i++],
+          style: data[i++] as CollectionStyle
+        })
+        break
+      }
+      case TAPE_SCALAR_FAST: {
+        events.push({
+          type: EVENT_ID.SCALAR,
+          valueStart: data[i++],
+          valueEnd: data[i++],
+          anchorStart: NO_RANGE,
+          anchorEnd: NO_RANGE,
+          tagStart: NO_RANGE,
+          tagEnd: NO_RANGE,
+          style: ((header >>> 4) & 0x0F) as ScalarStyle,
+          chomping: CHOMPING_MODE.CLIP,
+          indent: -1,
+          fast: ((header >>> 8) & 1) === 1
+        })
+        break
+      }
+      case TAPE_SCALAR_FULL: {
+        events.push({
+          type: EVENT_ID.SCALAR,
+          valueStart: data[i++],
+          valueEnd: data[i++],
+          anchorStart: data[i++],
+          anchorEnd: data[i++],
+          tagStart: data[i++],
+          tagEnd: data[i++],
+          style: data[i++] as ScalarStyle,
+          chomping: data[i++] as ChompingMode,
+          indent: data[i++],
+          fast: data[i++] === 1
+        })
+        break
+      }
+      case TAPE_ALIAS: {
+        events.push({
+          type: EVENT_ID.ALIAS,
+          anchorStart: data[i++],
+          anchorEnd: data[i++]
+        })
+        break
+      }
+      case TAPE_POP: {
+        events.push({ type: EVENT_ID.POP })
+        break
+      }
+    }
+  }
+
+  return events
+}
+
+export {
+  TAPE_DOCUMENT,
+  TAPE_SEQ_FAST,
+  TAPE_SEQ_FULL,
+  TAPE_MAP_FAST,
+  TAPE_MAP_FULL,
+  TAPE_SCALAR_FAST,
+  TAPE_SCALAR_FULL,
+  TAPE_ALIAS,
+  TAPE_POP,
+  materializeEvents,
+  type EventTape
+}
