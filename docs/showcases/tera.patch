+    /// Zero-copy borrowed lookup for standard variables (returns `None` for synthetic `__tera_loop_*`
+    /// or undefined names, falling back to `get_value`).
+    #[inline(always)]
+    pub(crate) fn lookup_borrowed<'a>(
+        for_loops: &'a [ForLoop<'t>],
+        set_variables: &'a BTreeMap<&'t str, Value>,
+        include_parent: Option<&'a State<'t>>,
+        context: &'a Context,
+        global_context: Option<&'a Context>,
+        name: &str,
+    ) -> Option<&'a Value> {
+        if name.as_bytes().first() == Some(&b'_') && name.starts_with("__tera_loop_") {
+            return None;
+        }
+
+        for forloop in for_loops.iter().rev() {
+            if let Some(v) = forloop.get_borrowed(name) {
+                return Some(v);
+            }
+        }
+
+        if !set_variables.is_empty()
+            && let Some(val) = set_variables.get(name)
+        {
+            return Some(val);
+        }
+
+        if let Some(parent) = include_parent
+            && let Some(val) = parent.get_borrowed(name)
+            && !val.is_undefined()
+        {
+            return Some(val);
+        }
+
+        if let Some(val) = context.data.get(name) {
+            return Some(val);
+        }
+
+        if let Some(global) = global_context
+            && !global.data.is_empty()
+            && let Some(val) = global.data.get(name)
+        {
+            return Some(val);
+        }
+
+        None
+    }
