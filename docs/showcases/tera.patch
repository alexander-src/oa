diff --git a/tera/src/template.rs b/tera/src/template.rs
index b38d309..765cc8f 100644
--- a/tera/src/template.rs
+++ b/tera/src/template.rs
@@ -7,6 +7,44 @@ use crate::parsing::{Chunk, Compiler};
 use crate::tera::Tera;
 use crate::utils::Span;
 use std::collections::HashSet;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+const MAX_ADAPTIVE_SIZE_HINT: usize = 4 * 1024 * 1024;
+
+/// Lock-free adaptive output buffer size hint so repeated renders avoid Vec reallocations.
+#[derive(Debug)]
+pub(crate) struct AdaptiveSizeHint(AtomicUsize);
+
+impl AdaptiveSizeHint {
+    fn new(initial: usize) -> Self {
+        Self(AtomicUsize::new(initial))
+    }
+
+    #[inline]
+    fn get(&self) -> usize {
+        self.0.load(Ordering::Relaxed)
+    }
+
+    #[inline]
+    fn observe(&self, rendered_len: usize) {
+        let clamped = rendered_len.min(MAX_ADAPTIVE_SIZE_HINT);
+        if clamped > self.0.load(Ordering::Relaxed) {
+            self.0.store(clamped, Ordering::Relaxed);
+        }
+    }
+}
+
+impl Clone for AdaptiveSizeHint {
+    fn clone(&self) -> Self {
+        Self(AtomicUsize::new(self.0.load(Ordering::Relaxed)))
+    }
+}
+
+impl PartialEq for AdaptiveSizeHint {
+    fn eq(&self, _other: &Self) -> bool {
+        true
+    }
+}
 
